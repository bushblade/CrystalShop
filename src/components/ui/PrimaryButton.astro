---
import { primaryButtonClasses, primaryButtonSizeClasses } from './buttonClasses'

interface Props {
	href?: string
	size?: 'md' | 'sm'
	class?: string
}

const { href, size = 'md', class: className = '', ...attrs } = Astro.props

const classes = [primaryButtonClasses, primaryButtonSizeClasses[size], className]
---

{href ? (
	<a href={href} class:list={classes} {...attrs}>
		<slot />
	</a>
) : (
	<button type="button" class:list={classes} {...attrs}>
		<slot />
	</button>
)}
