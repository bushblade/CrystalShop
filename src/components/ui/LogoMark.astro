---
interface Props {
	class?: string
}

const { class: className } = Astro.props
---

<svg
	viewBox="0 0 64 64"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	class={className}
>
	<defs>
		<linearGradient id="logo-facet-l" x1="32" y1="9" x2="32" y2="55" gradientUnits="userSpaceOnUse">
			<stop stop-color="#5b21b6"></stop>
			<stop offset="1" stop-color="#4c1d95"></stop>
		</linearGradient>
		<linearGradient id="logo-facet-r" x1="32" y1="9" x2="32" y2="55" gradientUnits="userSpaceOnUse">
			<stop stop-color="#8b5cf6"></stop>
			<stop offset="1" stop-color="#6d28d9"></stop>
		</linearGradient>
	</defs>
	<circle
		cx="32"
		cy="32"
		r="29"
		stroke="#8b5cf6"
		stroke-width="2"
		stroke-linecap="round"
		stroke-dasharray="50 11 86 11 24.2"></circle>
	<circle cx="32" cy="32" r="25" fill="#0c0a09"></circle>
	<path d="M32 9 L22 19 V45 L32 55 Z" fill="url(#logo-facet-l)"></path>
	<path d="M32 9 L42 19 V45 L32 55 Z" fill="url(#logo-facet-r)"></path>
	<path d="M32 9 L42 19 H36.5 Z" fill="#c4b5fd"></path>
</svg>
