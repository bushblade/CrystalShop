---
import type { CATEGORIES_QUERY_RESULT } from '../../../sanity.types'

interface Props {
	categories: CATEGORIES_QUERY_RESULT
	activeSlug?: string | null
}

const { categories, activeSlug = null } = Astro.props

function categoryPillClasses(isActive: boolean): string[] {
	return [
		'rounded-full border px-4 py-1.5 text-xs font-medium uppercase tracking-[0.14em] transition-colors',
		isActive
			? 'border-stone-900 bg-stone-900 text-white'
			: 'border-stone-300 text-stone-600 hover:border-stone-900 hover:text-stone-900',
	]
}
---

<nav class="flex flex-wrap gap-2" aria-label="Categories">
	<a href="/shop" class:list={categoryPillClasses(activeSlug === null)}>
		All
	</a>
	{categories.map((category) => (
		<a
			href={`/shop/categories/${category.slug}`}
			class:list={categoryPillClasses(activeSlug === category.slug)}
		>
			{category.name}
		</a>
	))}
</nav>
