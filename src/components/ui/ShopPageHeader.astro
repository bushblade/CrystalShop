---
import type { CATEGORIES_QUERY_RESULT } from '../../../sanity.types'
import CategoryNav from './CategoryNav.astro'
import PageHeading from './PageHeading.astro'

interface Props {
	title: string
	categories: CATEGORIES_QUERY_RESULT
	activeSlug?: string | null
}

const { title, categories, activeSlug = null } = Astro.props
---

<header class="mb-10 border-b border-stone-200/80 pb-8">
	<PageHeading class="mb-5">{title}</PageHeading>
	<CategoryNav categories={categories} activeSlug={activeSlug} />
</header>
