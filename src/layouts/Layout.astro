---
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/inter/700.css'
import '@fontsource/cormorant-garamond/400.css'
import '@fontsource/cormorant-garamond/400-italic.css'
import '@fontsource/cormorant-garamond/500.css'
import '@fontsource/cormorant-garamond/600.css'
import { sanityClient } from 'sanity:client'
import CartFreshnessChecker from '../components/CartFreshnessChecker'
import SiteFooter from '../components/ui/SiteFooter.astro'
import SiteHeader from '../components/ui/SiteHeader.astro'
import Toaster from '../components/ui/Toaster'
import { extractShippingRates } from '../lib/siteSettings'
import { SITE_SETTINGS_QUERY } from '../queries/sanity'
import '../styles/global.css'

interface Props {
	title?: string
	description?: string
	maxWidth?: '3xl' | '6xl'
	padded?: boolean
}

const {
	title = 'Eclipsia Crystals',
	description = 'Natural crystals, handpicked for you.',
	maxWidth = '6xl',
	padded = true,
} = Astro.props
const siteSettings = await sanityClient.fetch(SITE_SETTINGS_QUERY)
const contactEmail = siteSettings?.contactEmail
const shippingRates = extractShippingRates(siteSettings)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
		<noscript>
			<style>img[data-fade-in] { opacity: 1 !important; }</style>
		</noscript>
	</head>
	<body class="flex min-h-screen flex-col">
		<SiteHeader shippingRates={shippingRates} />
		<main
			class:list={[
				'mx-auto w-full flex-1 px-4',
				maxWidth === '3xl' ? 'max-w-3xl' : 'max-w-6xl',
				padded ? 'py-12 sm:py-16' : '',
			]}
		>
			<CartFreshnessChecker client:load />
			<Toaster client:only="react" />
			<slot />
		</main>
		<SiteFooter contactEmail={contactEmail} />
		<script>
			import { transitionImage } from '../utils/transitionImage'
			const images = document.querySelectorAll<HTMLImageElement>('img[data-fade-in]')
			for (const image of images) {
				transitionImage(image)
			}
		</script>
	</body>
</html>
