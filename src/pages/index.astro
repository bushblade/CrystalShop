---
import { sanityClient } from 'sanity:client'
import PrimaryButton from '../components/ui/PrimaryButton.astro'
import ProductGrid from '../components/ui/ProductGrid'
import Layout from '../layouts/Layout.astro'
import { FEATURED_PRODUCTS_QUERY } from '../queries/sanity'

const featured = await sanityClient.fetch(FEATURED_PRODUCTS_QUERY)
---

<Layout
	title="Eclipsia Crystals | Natural Crystals"
	description="Handpicked natural crystals, each piece unique and ready to be yours."
	padded={false}
>
	<section class="py-16 text-center sm:py-24">
			<h1 class="text-4xl font-semibold text-stone-900 sm:text-5xl">Eclipsia Crystals</h1>
			<p class="mx-auto mt-4 max-w-xl text-lg text-stone-600">
				Handpicked natural crystals — clusters, points and one-of-a-kind pieces, each with its own story.
			</p>
			<PrimaryButton href="/shop" class="mt-8 inline-block">
				Shop all crystals
			</PrimaryButton>
		</section>

		{featured.length > 0 ? (
			<section class="pb-16">
				<h2 class="font-display text-2xl font-semibold text-stone-900">Featured pieces</h2>
				<ProductGrid products={featured} />
			</section>
		) : null}
</Layout>
