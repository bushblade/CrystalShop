---
import { sanityClient } from 'sanity:client'
import ProsePage from '../components/ui/ProsePage.astro'
import { SITE_SETTINGS_QUERY } from '../queries/sanity'

const siteSettings = await sanityClient.fetch(SITE_SETTINGS_QUERY)
---

<ProsePage
	title="Terms | Eclipsia Crystals"
	description="Terms and conditions for shopping at Eclipsia Crystals."
	heading="Terms & Conditions"
	body={siteSettings?.termsBody}
/>
