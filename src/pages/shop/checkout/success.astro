---
import NavLink from '../../../components/ui/NavLink.astro'
import PageHeading from '../../../components/ui/PageHeading.astro'
import Layout from '../../../layouts/Layout.astro'
---

<Layout
	title="Order complete | Eclipsia Crystals"
	description="Thank you for your order — we'll be in touch about dispatch."
>
	<PageHeading>Thank you — your order is on its way</PageHeading>
	<p class="mt-4 text-stone-600">
		We've received your payment. If your order needs a delivery arrangement, we'll contact you
		shortly.
	</p>
	<p class="mt-6">
		<NavLink href="/shop" class="font-medium text-violet-700">Back to shop</NavLink>
	</p>
</Layout>

<script>
	import { useCartStore } from '../../../lib/cart'

	// Clear the cart after a completed purchase. Stripe redirects here once
	// payment succeeds, but nothing else in the flow ever empties the cart —
	// without this, the just-bought items would linger and CartFreshnessChecker
	// would misreport them as "sold out while you were away" on the next page.
	// Gated on the session_id query param so a stray visit to this URL doesn't
	// wipe a cart that's still in progress. Runs at page load, before the
	// freshness check's network fetch resolves, so it never toasts.
	if (new URLSearchParams(window.location.search).has('session_id')) {
		useCartStore.getState().clear()
	}
</script>