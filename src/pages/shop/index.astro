---
import { sanityClient } from 'sanity:client'
import CatalogExplorer from '../../components/CatalogExplorer'
import ShopPageHeader from '../../components/ui/ShopPageHeader.astro'
import Layout from '../../layouts/Layout.astro'
import { CATEGORIES_QUERY, IN_STOCK_PRODUCTS_QUERY } from '../../queries/sanity'

const [products, categories] = await Promise.all([
	sanityClient.fetch(IN_STOCK_PRODUCTS_QUERY),
	sanityClient.fetch(CATEGORIES_QUERY),
])
---

<Layout
	title="Shop Crystals | Eclipsia Crystals"
	description="Browse our collection of natural crystals — clusters, points and one-of-a-kind pieces."
>
	<ShopPageHeader title="All Crystals" categories={categories} />
	<CatalogExplorer client:load products={products} initialSearchParamsFromAstro={Astro.url.search} />
</Layout>
