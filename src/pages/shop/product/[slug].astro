---
import { sanityClient } from 'sanity:client'
import AddToCartButton from '../../../components/AddToCartButton'
import ProductGallery from '../../../components/ProductGallery'
import NavLink from '../../../components/ui/NavLink.astro'
import PageHeading from '../../../components/ui/PageHeading.astro'
import Layout from '../../../layouts/Layout.astro'
import { formatPrice, formatWeight } from '../../../lib/format'
import { getCartShipping } from '../../../lib/shipping'
import { PRODUCT_BY_SLUG_QUERY, SITE_SETTINGS_QUERY } from '../../../queries/sanity'

const { slug } = Astro.params

const product = await sanityClient.fetch(PRODUCT_BY_SLUG_QUERY, { slug })

if (!product) {
	return Astro.redirect('/shop')
}

const isSoldOut = (product.stockLevel ?? 0) === 0

const siteSettings = await sanityClient.fetch(SITE_SETTINGS_QUERY)
const shippingRates =
	siteSettings?.shippingRates?.map((rate) => ({
		name: rate.name,
		maxWeightGrams: rate.maxWeightGrams ?? null,
		price: rate.price,
	})) ?? []
const shipping = getCartShipping(
	[{ deliveryMethod: product.deliveryMethod, weightInGrams: product.weightInGrams ?? 0 }],
	shippingRates,
)

const maxQuantity = product.isUniquePiece ? 1 : (product.stockLevel ?? 0)
const heroImage = product.images?.[0]
const cartItem = {
	id: product._id,
	name: product.name,
	slug: product.slug ?? '',
	price: product.price,
	weightInGrams: product.weightInGrams ?? 0,
	image: { url: heroImage?.url ?? '', alt: heroImage?.alt ?? product.name },
	deliveryMethod: product.deliveryMethod,
}
---

<Layout title={`${product.name} | Eclipsia Crystals`} description={product.description ?? undefined}>
	<nav class="text-sm text-stone-500" aria-label="Breadcrumb">
			<NavLink href="/shop">Shop</NavLink>
			<span aria-hidden="true"> / </span>
			<NavLink href={`/shop/categories/${product.category.slug}`}>
				{product.category.name}
			</NavLink>
			<span aria-hidden="true"> / </span>
			<span class="text-stone-800">{product.name}</span>
		</nav>

		<div class="mt-8 grid gap-10 lg:grid-cols-2">
			<ProductGallery client:load images={product.images ?? []} name={product.name} />

			<div>
				{product.isUniquePiece ? (
					<p class="text-sm font-medium text-violet-700">Unique 1-of-1 piece</p>
				) : null}
				<PageHeading class="mt-2">{product.name}</PageHeading>
				<p class="mt-3 text-2xl font-medium text-stone-900">{formatPrice(product.price)}</p>
				{shipping.applies && shipping.rate ? (
					<p class="mt-1 text-sm text-stone-500">
						Shipping from{' '}
						<NavLink href="/shipping" class="font-medium text-violet-700 underline underline-offset-2">
							{formatPrice(shipping.rate.price)}
						</NavLink>
					</p>
				) : null}

				{product.description ? (
					<p class="mt-6 whitespace-pre-line text-stone-700">{product.description}</p>
				) : null}

				{!shipping.applies ? (
					<p class="mt-6 rounded-lg bg-violet-50 px-4 py-3 text-sm text-violet-800">
						{product.deliveryMethod === 'arrange'
							? 'Collection or local delivery — '
							: 'This piece is too heavy for standard postage — '}
						<NavLink href="/contact" class="font-medium underline underline-offset-2">contact us</NavLink> to arrange.
					</p>
				) : null}

				<dl class="mt-8 space-y-2 text-sm text-stone-600">
					{product.weightInGrams ? (
						<div class="flex justify-between border-b border-stone-100 py-2">
							<dt>Weight</dt>
							<dd class="text-stone-800">{formatWeight(product.weightInGrams)}</dd>
						</div>
					) : null}
					{product.countryOfOrigin ? (
						<div class="flex justify-between border-b border-stone-100 py-2">
							<dt>Country of origin</dt>
							<dd class="text-stone-800">{product.countryOfOrigin}</dd>
						</div>
					) : null}
				</dl>

				<div class="mt-8">
					{isSoldOut ? (
						<span class="inline-block rounded-full bg-stone-200 px-6 py-3 font-medium text-stone-600">
							Sold out
						</span>
					) : (
						<AddToCartButton client:load item={cartItem} maxQuantity={maxQuantity} />
					)}
				</div>
			</div>
		</div>
</Layout>
