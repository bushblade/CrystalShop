---
import { sanityClient } from 'sanity:client'
import AddToCartButton from '../../../components/AddToCartButton'
import ProductGallery from '../../../components/ProductGallery'
import NavLink from '../../../components/ui/NavLink.astro'
import PageHeading from '../../../components/ui/PageHeading.astro'
import Layout from '../../../layouts/Layout.astro'
import { formatPrice, formatWeight } from '../../../lib/format'
import { getCartShipping } from '../../../lib/shipping'
import { extractShippingRates } from '../../../lib/siteSettings'
import { PRODUCT_BY_SLUG_QUERY, SITE_SETTINGS_QUERY } from '../../../queries/sanity'

const { slug } = Astro.params

const product = await sanityClient.fetch(PRODUCT_BY_SLUG_QUERY, { slug })

if (!product) {
	return Astro.redirect('/shop')
}

const isSoldOut = (product.stockLevel ?? 0) === 0

const siteSettings = await sanityClient.fetch(SITE_SETTINGS_QUERY)
const shippingRates = extractShippingRates(siteSettings)
const shipping = getCartShipping(
	[{ deliveryMethod: product.deliveryMethod, weightInGrams: product.weightInGrams ?? 0 }],
	shippingRates,
)

const heroImage = product.images?.[0]
const cartItem = {
	id: product._id,
	name: product.name,
	slug: product.slug ?? '',
	price: product.price,
	weightInGrams: product.weightInGrams ?? 0,
	image: { url: heroImage?.url ?? '', alt: heroImage?.alt ?? product.name },
	deliveryMethod: product.deliveryMethod,
}
---

<Layout title={`${product.name} | Eclipsia Crystals`} description={product.description ?? undefined}>
	<nav class="text-xs font-medium uppercase tracking-[0.14em] text-stone-500" aria-label="Breadcrumb">
		<NavLink href="/shop">Shop</NavLink>
		<span aria-hidden="true"> / </span>
		<NavLink href={`/shop/categories/${product.category.slug}`}>
			{product.category.name}
		</NavLink>
		<span aria-hidden="true"> / </span>
		<span class="text-stone-900">{product.name}</span>
	</nav>

		<div class="mt-8 grid gap-10 lg:grid-cols-2">
			<ProductGallery client:load images={product.images ?? []} name={product.name} />

			<div>
				{product.isUniquePiece ? (
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-violet-700">
						Unique 1-of-1 piece
					</p>
				) : null}
				<PageHeading class="mt-3">{product.name}</PageHeading>
				<p class="mt-4 text-3xl font-medium text-stone-950">{formatPrice(product.price)}</p>
				{shipping.applies && shipping.rate ? (
					<p class="mt-1 text-sm text-stone-500">
						Shipping from{' '}
						<NavLink href="/shipping" class="font-medium text-violet-700 underline underline-offset-2">
							{formatPrice(shipping.rate.price)}
						</NavLink>
					</p>
				) : null}

				{product.description ? (
					<p class="mt-6 whitespace-pre-line leading-relaxed text-stone-600">{product.description}</p>
				) : null}

				{!shipping.applies ? (
					<p class="mt-6 rounded-sm border border-violet-100 bg-violet-50/60 px-4 py-3 text-sm text-violet-900">
						{product.deliveryMethod === 'arrange'
							? 'Collection or local delivery — '
							: 'This piece is too heavy for standard postage — '}
						<NavLink href="/contact" class="font-medium underline underline-offset-2">contact us</NavLink> to arrange.
					</p>
				) : null}

				<dl class="mt-8 border-t border-stone-200">
					{product.weightInGrams ? (
						<div class="flex justify-between border-b border-stone-200 py-3">
							<dt class="text-stone-500">Weight</dt>
							<dd class="font-medium text-stone-950">{formatWeight(product.weightInGrams)}</dd>
						</div>
					) : null}
					{product.countryOfOrigin ? (
						<div class="flex justify-between border-b border-stone-200 py-3">
							<dt class="text-stone-500">Country of origin</dt>
							<dd class="font-medium text-stone-950">{product.countryOfOrigin}</dd>
						</div>
					) : null}
				</dl>

				<div class="mt-8">
					{isSoldOut ? (
						<span class="inline-block rounded-full border border-stone-300 px-6 py-3 text-sm font-medium uppercase tracking-[0.12em] text-stone-500">
							Sold out
						</span>
					) : (
						<AddToCartButton
							client:load
							item={cartItem}
							stockLevel={product.stockLevel ?? 0}
							isUniquePiece={product.isUniquePiece === true}
						/>
					)}
				</div>
			</div>
		</div>
</Layout>
