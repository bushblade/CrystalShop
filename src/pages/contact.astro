---
import { sanityClient } from 'sanity:client'
import ContactForm from '../components/ui/ContactForm'
import PageHeading from '../components/ui/PageHeading.astro'
import Layout from '../layouts/Layout.astro'
import { SITE_SETTINGS_QUERY } from '../queries/sanity'

const siteSettings = await sanityClient.fetch(SITE_SETTINGS_QUERY)
const contactEmail = siteSettings?.contactEmail
---

<Layout
	title="Contact | Eclipsia Crystals"
	description="Get in touch with Eclipsia Crystals about an order or a piece you're looking for."
	maxWidth="3xl"
>
	<PageHeading>Contact</PageHeading>
	<div class="mt-6 space-y-4 text-stone-700">
		<p>
			If you have a question about a piece, a shipping estimate, or local pickup
			arrangements, we'd love to hear from you.
		</p>
		{contactEmail ? (
			<p>
				Email us at{' '}
				<a
					href={`mailto:${contactEmail}`}
					class="font-medium text-violet-700 transition-colors hover:text-violet-800"
				>
					{contactEmail}
				</a> or fill in the form below.
			</p>
		) : null}
	</div>
	<ContactForm client:load />
</Layout>
