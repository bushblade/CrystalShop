---
import Layout from '../layouts/Layout.astro'
---

<Layout
	title="Contact | Eclipsia Crystals"
	description="Get in touch with Eclipsia Crystals about an order or a piece you're looking for."
	maxWidth="3xl"
>
	<h1 class="text-3xl font-semibold text-stone-900">Contact</h1>
	<div class="mt-6 space-y-4 text-stone-700">
		<p>
			If you have a question about a piece, a shipping estimate, or local pickup
			arrangements, we'd love to hear from you.
		</p>
		<p>
			Email us at{' '}
			<a href="mailto:hello@eclipsiacrystals.com" class="text-violet-700 underline transition-colors hover:text-violet-800">
				hello@eclipsiacrystals.com
			</a>
			.
		</p>
	</div>
</Layout>
