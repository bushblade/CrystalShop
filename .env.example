# Sanity project ID (find it at sanity.io/manage). Read by the app AND by the
# Netlify functions (create-checkout-session, stripe-webhook).
PUBLIC_SANITY_STUDIO_PROJECT_ID=
# Dataset: "development" for local work, "production" on the deployed site
# (Netlify build env must set PUBLIC_SANITY_STUDIO_DATASET=production).
# The Netlify functions read this too — the dataset must match the livemode
# gate: test Stripe keys write to "development", live keys to "production".
PUBLIC_SANITY_STUDIO_DATASET=development
# Sanity writer token (sanity.io/manage -> API -> Add API token). Required by the
# Netlify functions (stripe-webhook writes the `order` doc and decrements stock),
# and by scripts/seed-dummy-data.mjs. Keep it out of any public env.
# SANITY_WRITE_TOKEN=

# Stripe — Test mode keys for now (see docs/plan-c-stripe-migration.md).
# Never prefix any of these with PUBLIC_ — they must stay server-only.
# Uncomment and fill when wiring Stripe locally or on Netlify:
# STRIPE_RESTRICTED_KEY=           # Restricted key (rk_test_...), scoped to checkout.sessions read+write. Used by /api/checkout + webhook verification. Required for checkout/webhook.
# STRIPE_PUBLISHABLE_KEY=          # Publishable key (pk_test_...). Reserved — not required by the current hosted-Checkout flow (server returns session.url). Uncomment only if adding Stripe.js/Payment Element.
# STRIPE_WEBHOOK_SECRET=           # Webhook signing secret. LOCAL: the whsec_ printed by "stripe listen".
#                                  # DEPLOYED: a different whsec_ from the Stripe dashboard webhook endpoint,
#                                  # set in Netlify env — not the local value.
# STRIPE_EXPECTED_MODE=test        # "test" or "live" — gates which Stripe events the webhook processes.
#                                  # test keys write to the "development" dataset, live keys to "production".
#                                  # Misconfiguring this means orders silently never land — double-check it per site.

# Prerequisites for local checkout/webhook: Stripe CLI (npm install --global @stripe/cli && stripe login)
#   and Netlify CLI (already in devDependencies, runs via pnpm dev:netlify).
# Local webhook testing — no Netlify env changes needed:
#   1. stripe listen --forward-to localhost:8888/api/webhooks/stripe
#   2. Copy the printed whsec_... into .env as STRIPE_WEBHOOK_SECRET (local-only
#      value — the deployed site uses the dashboard webhook's secret, not this).
#   3. Ensure STRIPE_EXPECTED_MODE=test is set, then run: pnpm dev:netlify
#   4. Complete a real test checkout (card 4242 4242 4242 4242) — the CLI forwards
#      the event to localhost:8888/api/webhooks/stripe and the function processes it.
