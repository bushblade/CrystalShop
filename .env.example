# Sanity project ID (find it at sanity.io/manage)
PUBLIC_SANITY_STUDIO_PROJECT_ID=
# Dataset: "development" for local work, "production" on the deployed site
# (Netlify build env must set PUBLIC_SANITY_STUDIO_DATASET=production)
PUBLIC_SANITY_STUDIO_DATASET=development
# Sanity writer token for scripts/seed-dummy-data.mjs (sanity.io/manage -> API -> Add API token).
# NOT used by the app itself; keep it out of any public env.
# SANITY_WRITE_TOKEN=
