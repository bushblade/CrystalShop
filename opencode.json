{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"formatter": {
		"biome": { "enabled": true }
	},
	"mcp": {
		"Astro docs": {
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp",
			"enabled": true
		},
		"sanity": {
			"type": "remote",
			"url": "https://mcp.sanity.io",
			"oauth": {}
		},
		"netlify-mcp": {
			"type": "remote",
			"url": "https://netlify-mcp.netlify.app/mcp",
			"enabled": true
		},
		"stripe": {
			"type": "remote",
			"url": "https://mcp.stripe.com",
			"headers": {
				"Authorization": "{file:~/SyncThing/.secrets/stripe-api-key}"
			}
		}
	}
}
